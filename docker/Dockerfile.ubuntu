FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies (FFmpeg, VapourSynth build requirements) from the
# Ubuntu archive only. Python 3.12 is not in the 26.04 archive; it used to come
# from the deadsnakes PPA, but that made every build depend on Launchpad, whose
# outages (HTTP 500/503) broke CI for hours at a time. It now comes from uv's
# managed Python builds (python-build-standalone, fetched from GitHub and
# SHA-256-verified by uv against its bundled manifest), with uv itself pinned
# by tag and digest from GHCR.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    ffmpeg \
    git \
    build-essential \
    pkg-config \
    libffms2-5 \
    libffms2-dev \
    && rm -rf /var/lib/apt/lists/*

# uv 0.12.17 (multi-arch index digest).
COPY --from=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc /uv /usr/local/bin/uv

# Install a managed CPython 3.12 (headers, venv and ensurepip included) and
# expose it as python3.12 on PATH, which is what install.sh looks for first.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python
RUN uv python install 3.12 \
    && ln -s "$(uv python find 3.12)" /usr/local/bin/python3.12 \
    && python3.12 --version

WORKDIR /workspace

# Copy repository
COPY . /workspace

# Seed the same isolated venv used by install.sh so its vspipe wrapper is also
# available on PATH for subsequent Docker build and test commands.
ENV PATH="/workspace/.venv/bin:${PATH}"

# Run installer script
RUN chmod +x install.sh run_pipeline_localy.sh \
    && python3.12 -m venv .venv \
    && .venv/bin/pip install vapoursynth==79 \
    && ./install.sh

# Default command runs full linting, tests, and real E2E pipeline
CMD ["bash", "-c", "./run_pipeline_localy.sh && .venv/bin/pytest -v tests/"]
