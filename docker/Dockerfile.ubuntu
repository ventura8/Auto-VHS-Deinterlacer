FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies including Python 3.12 (via deadsnakes), FFmpeg, and VapourSynth build requirements
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    gpg-agent \
    curl \
    ca-certificates \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    ffmpeg \
    git \
    build-essential \
    pkg-config \
    libffms2-5 \
    libffms2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy repository
COPY . /workspace

# Seed the same isolated venv used by install.sh so its vspipe wrapper is also
# available on PATH for subsequent Docker build and test commands.
ENV PATH="/workspace/.venv/bin:${PATH}"

# Run installer script
RUN chmod +x install.sh run_pipeline_localy.sh \
    && python3.12 -m venv .venv \
    && .venv/bin/pip install vapoursynth==77 \
    && ./install.sh

# Default command runs full linting, tests, and real E2E pipeline
CMD ["bash", "-c", "./run_pipeline_localy.sh && .venv/bin/pytest -v tests/"]
